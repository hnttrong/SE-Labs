<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    </startup>
	<connectionStrings>
		<add name="SchoolDBConnectionString" connectionString="data source=(localdb)\MSSQLLocalDB;initial catalog=SchoolDB;integrated security=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>